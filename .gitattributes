# Set default behavior to automatically normalize line endings
* text=auto

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Docker files
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Env files
.env* text eol=lf
