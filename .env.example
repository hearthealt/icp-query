# 代理配置示例
# 复制此文件为 .env 并填写你的配置

# 固定代理列表（逗号分隔）
# MIIT_PROXIES=http://user:pass@1.2.3.4:8000,http://5.6.7.8:8000

# 动态代理 API（返回 ip:port 或 user:pass@ip:port）
# MIIT_PROXY_API_URL=https://your-proxy-api.com/get

# 代理认证（附加到无认证代理）
# MIIT_PROXY_AUTH=username:password

# 动态代理缓存时间（秒）
MIIT_PROXY_API_TTL=10

# 请求最小间隔（秒）
MIIT_MIN_INTERVAL=0.8

# 失败重试次数
MIIT_MAX_RETRIES=3

# 黑名单阈值（连续失败多少次）
MIIT_BLACKLIST_THRESHOLD=3

# 黑名单有效期（秒）
MIIT_BLACKLIST_DURATION=300
